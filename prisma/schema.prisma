generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String     @default("COMERCIAL")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  colaborador   Colaborador?
  auditLogs     AuditLog[]
  leadsResp     Lead[]            @relation("LeadResp")
  atendResp     Atendimento[]     @relation("AtendResp")
  visitasTec    Visita[]          @relation("VisitaTec")
  orcamentos    Orcamento[]       @relation("OrcVend")
  obras         Obra[]            @relation("ObraResp")
  etapasResp    Etapa[]           @relation("EtapaResp")
  diarios       DiarioObra[]
  movimentacoes MovimentacaoEstoque[]
  anexos        Anexo[]
  notificacoes  Notificacao[]
  chamados      ChamadoAssistencia[] @relation("ChamadoTec")

  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entity     String
  entityId   String
  payload    String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
}

model Cliente {
  id           String           @id @default(cuid())
  tipo         String
  nome         String
  documento    String           @unique
  email        String?
  telefone     String?
  whatsapp     String?
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  uf           String?
  categoria    String
  observacoes  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  leads        Lead[]
  atendimentos Atendimento[]
  visitas      Visita[]
  orcamentos   Orcamento[]
  contratos    Contrato[]
  obras        Obra[]
  contasReceber ContaReceber[]
  garantias    Garantia[]
  chamados     ChamadoAssistencia[]
  planosManutencao PlanoManutencao[]
  disparosTemporais DisparoTemporal[]
  pagamentos   Pagamento[]
  acesso       ClienteAcesso?

  @@index([nome])
  @@index([documento])
  @@index([categoria])
}

model ClienteAcesso {
  id           String   @id @default(cuid())
  clienteId    String   @unique
  cliente      Cliente  @relation(fields: [clienteId], references: [id])
  email        String   @unique
  passwordHash String
  ativo        Boolean  @default(true)
  ultimoLogin  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Lead {
  id              String      @id @default(cuid())
  clienteId       String?
  origem          String
  descricao       String
  urgencia        String    @default("MEDIA")
  status          String  @default("NOVO")
  motivoPerda     String?
  responsavelId   String
  proximaAcao     String?
  dataProximaAcao DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  cliente         Cliente?    @relation(fields: [clienteId], references: [id])
  responsavel     User        @relation("LeadResp", fields: [responsavelId], references: [id])
  atendimentos    Atendimento[]

  @@index([status])
  @@index([responsavelId])
}

model Atendimento {
  id            String              @id @default(cuid())
  leadId        String?
  clienteId     String
  canal         String
  descricao     String
  fotos         String?
  urgencia      String            @default("MEDIA")
  status        String   @default("ABERTO")
  responsavelId String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  lead          Lead?               @relation(fields: [leadId], references: [id])
  cliente       Cliente             @relation(fields: [clienteId], references: [id])
  responsavel   User                @relation("AtendResp", fields: [responsavelId], references: [id])
  visitas       Visita[]

  @@index([clienteId])
  @@index([status])
}

model Visita {
  id                  String        @id @default(cuid())
  atendimentoId       String?
  clienteId           String
  tecnicoId           String
  endereco            String
  dataAgendada        DateTime
  dataCheckIn         DateTime?
  dataCheckOut        DateTime?
  fotos               String?
  diagnostico         String?
  medidas             String?
  tipoSuperficie      String?
  causaProvavel       String?
  solucaoRecomendada  String?
  observacoes         String?
  status              String  @default("AGENDADA")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  atendimento         Atendimento?  @relation(fields: [atendimentoId], references: [id])
  cliente             Cliente       @relation(fields: [clienteId], references: [id])
  tecnico             User          @relation("VisitaTec", fields: [tecnicoId], references: [id])
  orcamentos          Orcamento[]

  @@index([clienteId])
  @@index([tecnicoId])
  @@index([status])
}

model Servico {
  id                    String         @id @default(cuid())
  nome                  String
  descricao             String?
  unidade               String
  custoPadrao           Float
  precoPadrao           Float
  tempoMedio            Float?
  observacoesTecnicas   String?
  ativo                 Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // --- Bloco 2: motor de orçamento (cálculo automático de custoPadrao/precoPadrao) ---
  percaPercent             Float?    // perdas/sobreposição sobre subtotal de materiais, ex.: 0.08 = 8%
  maoDeObraPorUnidade      Float?    // R$ por unidade do Servico.unidade
  equipamentosPorUnidade   Float?    // R$ por unidade
  episTransportePorUnidade Float?    // R$ por unidade
  bdiPercent               Float?    // sobre (materiais+perdas+mão de obra+equipamentos+epis)
  impostosPercent          Float?    // sobre subtotal+BDI
  lucroPercent             Float?    // sobre subtotal+BDI+impostos
  custoCalculadoEm         DateTime? // última vez que o motor recalculou custoPadrao/precoPadrao

  materiais             ServicoMaterial[]
  itensOrcamento        OrcamentoItem[]

  @@index([nome])
}

model ServicoMaterial {
  id          String   @id @default(cuid())
  servicoId   String
  materialId  String
  quantidade  Float

  servico     Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  material    Material @relation(fields: [materialId], references: [id])

  @@unique([servicoId, materialId])
}

// Bloco 1 — Módulo de Inteligência de Compras + Orçamentação.
// Fabricante do produto (Viapol, Sika, Quartzolit...), distinto do Fornecedor (quem vende/distribui).
model Fabricante {
  id                     String   @id @default(cuid())
  nome                   String   @unique
  ativo                  Boolean  @default(true)
  catalogoSincronizado   Boolean  @default(false)
  fichaTecnicaUrl        String?
  fispqUrl               String?
  normasTecnicas         String?
  garantiaAnosPadrao     Int?
  observacoes            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  produtos               Material[]

  @@index([nome])
}

model Material {
  id                  String   @id @default(cuid())
  nome                String
  categoria           String
  unidade             String
  custoMedio          Float
  estoqueAtual        Float    @default(0)
  estoqueMinimo       Float    @default(0)
  fornecedorPadraoId  String?
  ativo               Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // --- Bloco 1: inteligência de compras/orçamentação ---
  fabricanteId        String?
  codigo              String?
  codigoBarras        String?
  embalagem           String?
  rendimentoM2        Float?
  tempoCuraHoras      Int?
  precoMedio          Float?
  ultimoPrecoPago     Float?
  custoFrete          Float?
  icmsPercent         Float?
  ipiPercent          Float?
  pisPercent          Float?
  cofinsPercent       Float?
  validade            DateTime?
  leadTimeDias        Int?

  fornecedorPadrao    Fornecedor? @relation(fields: [fornecedorPadraoId], references: [id])
  fabricante          Fabricante? @relation(fields: [fabricanteId], references: [id])
  servicos            ServicoMaterial[]
  movimentacoes       MovimentacaoEstoque[]
  itensCompra         ItemCompra[]
  precos              PrecoHistorico[]

  @@index([nome])
  @@index([categoria])
  @@index([fabricanteId])
}

model MovimentacaoEstoque {
  id              String           @id @default(cuid())
  materialId      String
  tipo            String
  quantidade      Float
  custoUnit       Float
  obraId          String?
  pedidoCompraId  String?
  observacao      String?
  userId          String
  createdAt       DateTime         @default(now())

  material        Material         @relation(fields: [materialId], references: [id])
  obra            Obra?            @relation(fields: [obraId], references: [id])
  pedidoCompra    PedidoCompra?    @relation(fields: [pedidoCompraId], references: [id])
  user            User             @relation(fields: [userId], references: [id])

  @@index([materialId])
  @@index([obraId])
}

model Fornecedor {
  id           String   @id @default(cuid())
  nome         String
  cnpj         String   @unique
  contato      String?
  email        String?
  telefone     String?
  endereco     String?
  observacoes  String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Bloco 1: inteligência de compras/orçamentação ---
  regiaoAtendida          String?
  representanteNome       String?
  representanteTelefone   String?
  representanteWhatsapp   String?
  prazoMedioDias          Int?
  prazoNegociadoDias      Int?
  freteDescricao          String?
  pedidoMinimo            Float?
  descontoVolumePercent   Float?
  tabelaVigenteUrl        String?
  indiceAtrasoPercent     Float?
  indiceQualidade         Float?
  avaliacaoMedia          Float?

  materiais    Material[]
  pedidos      PedidoCompra[]
  contasPagar  ContaPagar[]
  precos       PrecoHistorico[]

  @@index([nome])
}

model Orcamento {
  id                String          @id @default(cuid())
  numero            String          @unique
  clienteId         String
  visitaId          String?
  dataValidade      DateTime
  status            String @default("RASCUNHO")
  subtotal          Float           @default(0)
  desconto          Float           @default(0)
  total             Float           @default(0)
  custoEstimado     Float           @default(0)
  margemPrevista    Float           @default(0)
  condicaoPagamento String?
  prazoExecucao     String?
  observacoes       String?
  vendedorId        String
  criadoEm          DateTime        @default(now())
  aprovadoEm        DateTime?
  updatedAt         DateTime        @updatedAt

  cliente           Cliente         @relation(fields: [clienteId], references: [id])
  visita            Visita?         @relation(fields: [visitaId], references: [id])
  vendedor          User            @relation("OrcVend", fields: [vendedorId], references: [id])
  itens             OrcamentoItem[]
  contrato          Contrato?

  @@index([clienteId])
  @@index([status])
}

model OrcamentoItem {
  id           String   @id @default(cuid())
  orcamentoId  String
  servicoId    String
  descricao    String
  area         Float?
  quantidade   Float
  unidade      String
  custoUnit    Float
  precoUnit    Float
  subtotal     Float

  orcamento    Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  servico      Servico   @relation(fields: [servicoId], references: [id])
}

model Contrato {
  id                  String         @id @default(cuid())
  numero              String         @unique
  orcamentoId         String         @unique
  clienteId           String
  valor               Float
  condicaoPagamento   String
  prazoExecucao       String
  garantiaMeses       Int            @default(60)
  escopo              String
  obrigacoesCliente   String?
  obrigacoesEmpresa   String?
  clausulasExtras     String?
  status              String @default("PENDENTE")
  assinadoEm          DateTime?
  dataInicio          DateTime?
  dataFim             DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  orcamento           Orcamento      @relation(fields: [orcamentoId], references: [id])
  cliente             Cliente        @relation(fields: [clienteId], references: [id])
  obra                Obra?
  contasReceber       ContaReceber[]

  @@index([clienteId])
  @@index([status])
}

model Obra {
  id               String      @id @default(cuid())
  numero           String      @unique
  contratoId       String      @unique
  clienteId        String
  nome             String
  endereco         String
  responsavelId    String
  dataInicio       DateTime
  previsaoTermino  DateTime
  dataConclusao    DateTime?
  status           String  @default("AGUARDANDO")
  custoReal        Float       @default(0)
  margemReal       Float       @default(0)
  observacoes      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  contrato         Contrato        @relation(fields: [contratoId], references: [id])
  cliente          Cliente         @relation(fields: [clienteId], references: [id])
  responsavel      User            @relation("ObraResp", fields: [responsavelId], references: [id])
  etapas           Etapa[]
  diarios          DiarioObra[]
  medicoes         Medicao[]
  alocacoes        AlocacaoEquipe[]
  pontos           PontoCampo[]
  movimentacoes    MovimentacaoEstoque[]
  contasReceber    ContaReceber[]
  garantias        Garantia[]
  planosManutencao PlanoManutencao[]

  @@index([clienteId])
  @@index([status])
}

model Etapa {
  id              String       @id @default(cuid())
  obraId          String
  ordem           Int
  nome            String
  descricao       String?
  responsavelId   String?
  dataPrevista    DateTime
  dataRealizada   DateTime?
  status          String  @default("PENDENTE")
  checklist       String?
  fotos           String?
  observacoes     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  obra            Obra         @relation(fields: [obraId], references: [id], onDelete: Cascade)
  responsavel     User?        @relation("EtapaResp", fields: [responsavelId], references: [id])

  @@index([obraId])
}

model DiarioObra {
  id              String   @id @default(cuid())
  obraId          String
  data            DateTime
  autorId         String
  descricao       String
  condicaoTempo   String?
  problemas       String?
  fotos           String?
  createdAt       DateTime @default(now())

  // --- Diário automático pro cliente (WhatsApp) ---
  etapa            String?   // PRIMER | REGULARIZACAO | MANTA | MEMBRANA | TESTE | ENTREGA | CHUVA | GERAL
  m2               Float?
  lote             String?
  percentualObra   Int?
  fotoUrl          String?   // foto principal (link enviado ao cliente)
  visivelCliente   Boolean   @default(true)
  mensagemCliente  String?   // texto exato disparado no WhatsApp (vira prova)
  enviadoClienteEm DateTime?
  statusEnvio      String?   // PENDENTE | ENVIADO | FALHOU | SEM_WHATSAPP

  obra            Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  autor           User     @relation(fields: [autorId], references: [id])

  @@index([obraId])
  @@index([enviadoClienteEm])
}

model Medicao {
  id                  String        @id @default(cuid())
  obraId              String
  numero              Int
  dataReferencia      DateTime
  percentualExecutado Float
  valor               Float
  observacoes         String?
  status              String @default("PENDENTE")
  faturadoEm          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  obra                Obra          @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
}

model Colaborador {
  id          String             @id @default(cuid())
  userId      String?            @unique
  nome        String
  cpf         String             @unique
  telefone    String?
  funcao      String
  custoHora   Float              @default(0)
  custoDia    Float              @default(0)
  disponivel  Boolean            @default(true)
  observacoes String?
  ativo       Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User?              @relation(fields: [userId], references: [id])
  alocacoes   AlocacaoEquipe[]
  pontos      PontoCampo[]

  @@index([nome])
}

model AlocacaoEquipe {
  id              String      @id @default(cuid())
  obraId          String
  colaboradorId   String
  dataInicio      DateTime
  dataFim         DateTime?
  papel           String

  obra            Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id])

  @@index([obraId])
  @@index([colaboradorId])
}

model PontoCampo {
  id              String      @id @default(cuid())
  colaboradorId   String
  obraId          String
  tipo            String
  dataHora        DateTime
  lat             Float?
  lng             Float?
  observacao      String?

  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id])
  obra            Obra        @relation(fields: [obraId], references: [id])

  @@index([colaboradorId])
  @@index([obraId])
}

model PedidoCompra {
  id            String              @id @default(cuid())
  numero        String              @unique
  fornecedorId  String
  dataPedido    DateTime
  dataPrevista  DateTime
  status        String  @default("RASCUNHO")
  total         Float               @default(0)
  observacoes   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  fornecedor    Fornecedor          @relation(fields: [fornecedorId], references: [id])
  itens         ItemCompra[]
  movimentacoes MovimentacaoEstoque[]
  precos        PrecoHistorico[]

  @@index([fornecedorId])
  @@index([status])
}

model ItemCompra {
  id          String       @id @default(cuid())
  pedidoId    String
  materialId  String
  quantidade  Float
  custoUnit   Float
  subtotal    Float

  pedido      PedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  material    Material     @relation(fields: [materialId], references: [id])
}

// Bloco 1 — histórico de preços por material, para o futuro gráfico de evolução de preços.
model PrecoHistorico {
  id              String        @id @default(cuid())
  materialId      String
  fornecedorId    String?
  preco           Float
  dataReferencia  DateTime
  fonte           String?
  pedidoCompraId  String?
  createdAt       DateTime      @default(now())

  material        Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  fornecedor      Fornecedor?   @relation(fields: [fornecedorId], references: [id])
  pedidoCompra    PedidoCompra? @relation(fields: [pedidoCompraId], references: [id])

  @@index([materialId, dataReferencia])
}

model ContaReceber {
  id              String      @id @default(cuid())
  clienteId       String
  contratoId      String?
  obraId          String?
  descricao       String
  valor           Float
  vencimento      DateTime
  status          String @default("ABERTA")
  valorPago       Float       @default(0)
  formaPagamento  String?
  comprovanteUrl  String?
  observacoes     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  cliente         Cliente     @relation(fields: [clienteId], references: [id])
  contrato        Contrato?   @relation(fields: [contratoId], references: [id])
  obra            Obra?       @relation(fields: [obraId], references: [id])
  pagamentos      Pagamento[]

  @@index([clienteId])
  @@index([status])
}

model ContaPagar {
  id              String      @id @default(cuid())
  fornecedorId    String?
  categoria       String
  descricao       String
  valor           Float
  vencimento      DateTime
  status          String @default("ABERTA")
  valorPago       Float       @default(0)
  formaPagamento  String?
  comprovanteUrl  String?
  observacoes     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  fornecedor      Fornecedor? @relation(fields: [fornecedorId], references: [id])

  @@index([fornecedorId])
  @@index([status])
}

model Garantia {
  id            String          @id @default(cuid())
  obraId        String
  clienteId     String
  dataInicio    DateTime
  dataFim       DateTime
  prazoMeses    Int
  tipoGarantia  String
  condicoes     String?
  status        String  @default("ATIVA")
  // Garantia viva — avisos ao cliente (marco 180/90/30 dias antes do fim)
  avisosClienteEnviados Int      @default(0)
  ultimoAvisoClienteEm  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  obra          Obra            @relation(fields: [obraId], references: [id])
  cliente       Cliente         @relation(fields: [clienteId], references: [id])
  chamados      ChamadoAssistencia[]

  @@index([obraId])
  @@index([clienteId])
}

model ChamadoAssistencia {
  id              String        @id @default(cuid())
  garantiaId      String
  clienteId       String
  descricao       String
  dataAbertura    DateTime      @default(now())
  dataConclusao   DateTime?
  status          String @default("ABERTO")
  fotos           String?
  custoReparo     Float         @default(0)
  tecnicoId       String?
  observacoes     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  garantia        Garantia      @relation(fields: [garantiaId], references: [id])
  cliente         Cliente       @relation(fields: [clienteId], references: [id])
  tecnico         User?         @relation("ChamadoTec", fields: [tecnicoId], references: [id])

  @@index([garantiaId])
  @@index([clienteId])
  @@index([status])
}

model Anexo {
  id            String   @id @default(cuid())
  entidade      String
  entidadeId    String
  nome          String
  url           String
  tipo          String
  tamanho       Int
  uploadedById  String
  createdAt     DateTime @default(now())

  uploadedBy    User     @relation(fields: [uploadedById], references: [id])

  @@index([entidade, entidadeId])
}

model Notificacao {
  id        String   @id @default(cuid())
  userId    String
  tipo      String
  titulo    String
  mensagem  String
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([lida])
}

// Pagamento do cliente (Pix/cartão via Mercado Pago) de uma conta a receber.
model Pagamento {
  id             String   @id @default(cuid())
  contaReceberId String
  clienteId      String
  valor          Float
  metodo         String   @default("PIX") // PIX | CARTAO
  provedor       String   @default("MERCADOPAGO")
  providerId     String?  // id do pagamento no Mercado Pago
  status         String   @default("PENDENTE") // PENDENTE | APROVADO | RECUSADO | EXPIRADO | CANCELADO
  qrCode         String?  // imagem base64 do QR (data)
  copiaCola      String?  // pix copia-e-cola
  ticketUrl      String?
  expiraEm       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contaReceber   ContaReceber @relation(fields: [contaReceberId], references: [id])
  cliente        Cliente      @relation(fields: [clienteId], references: [id])

  @@index([contaReceberId])
  @@index([clienteId])
  @@index([providerId])
  @@index([status])
}

// Foto guardada no próprio banco (bytea) — servida pública em /api/foto/:id.
// Usada no diário de obra (link vai pro WhatsApp do cliente).
model Foto {
  id            String   @id @default(cuid())
  mime          String   @default("image/jpeg")
  dados         Bytes
  tamanho       Int      @default(0)
  contexto      String?  // ex.: "diario"
  criadoPorId   String?
  createdAt     DateTime @default(now())

  @@index([contexto])
}

model Configuracao {
  id         String   @id @default(cuid())
  chave      String   @unique
  valor      String
  descricao  String?
  updatedAt  DateTime @updatedAt
}

// Idea 16 — plano de manutenção preventiva anual (receita recorrente).
model PlanoManutencao {
  id                 String    @id @default(cuid())
  obraId             String
  clienteId          String
  periodicidadeMeses Int       @default(12)
  proximaData        DateTime
  valor              Float     @default(0)
  status             String    @default("ATIVO") // ATIVO | PAUSADO | CANCELADO
  ultimaExecucao     DateTime?
  ultimoAvisoEm      DateTime?
  observacoes        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  obra    Obra    @relation(fields: [obraId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@index([status])
  @@index([proximaData])
}

// Idea 28 — gatilho pós-temporal (chuva forte na cidade dispara oferta de vistoria).
model GatilhoTemporal {
  id              String    @id @default(cuid())
  cidade          String
  lat             Float
  lng             Float
  ativo           Boolean   @default(true)
  limiarChuvaMm   Float     @default(10)
  cooldownDias    Int       @default(15)
  mensagem        String    // template; {nome} vira o nome do cliente
  ultimoDisparoEm DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([ativo])
}

model DisparoTemporal {
  id        String   @id @default(cuid())
  clienteId String
  gatilhoId String
  chuvaMm   Float
  mensagem  String
  status    String // ENVIADO | FALHOU | SEM_WHATSAPP
  createdAt DateTime @default(now())

  cliente   Cliente  @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@index([createdAt])
}
