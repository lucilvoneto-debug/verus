# Postgres (Supabase) - Pooled connection (porta 6543, transaction mode)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Postgres (Supabase) - Direct connection (porta 5432) - usado pelo Prisma para migrations
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"

# Cron — usado por /api/cron/notifications
CRON_SECRET="gere-com-openssl-rand-hex-16"

# Integrações — WhatsApp (Z-API ou Evolution API)
WHATSAPP_PROVIDER="none"
WHATSAPP_TOKEN=""
WHATSAPP_INSTANCE=""
# Necessário apenas para Evolution API (host self-hosted)
WHATSAPP_HOST=""

# Integrações — NF-e / NFS-e (NFe.io, eNotas)
NFE_PROVIDER="none"
NFE_TOKEN=""

# Open-Meteo (previsão do tempo) — gratuito, sem API key. Override apenas para testes.
OPEN_METEO_BASE_URL="https://api.open-meteo.com"

# Acesso por link secreto — deixe VAZIO para desligar o atalho.
# Com um valor (32+ caracteres), abrir /entrar/<valor> entra direto no dashboard.
ACESSO_DIRETO_TOKEN=""
