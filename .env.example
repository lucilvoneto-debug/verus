# Postgres (Supabase) - Pooled connection (porta 6543, transaction mode)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Postgres (Supabase) - Direct connection (porta 5432) - usado pelo Prisma para migrations
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"

# Cron — usado por /api/cron/notifications
CRON_SECRET="gere-com-openssl-rand-hex-16"

# Integrações — WhatsApp (Z-API ou Evolution API)
WHATSAPP_PROVIDER="none"
WHATSAPP_TOKEN=""
WHATSAPP_INSTANCE=""
# Necessário apenas para Evolution API (host self-hosted)
WHATSAPP_HOST=""

# Integrações — NF-e / NFS-e (NFe.io, eNotas)
# NF-e/NFS-e: "nfeio" | "enotas" | "none". Sem token/company fica em mock.
NFE_PROVIDER="none"
NFE_TOKEN=""
NFE_COMPANY_ID=""
NFE_SERVICE_CODE="0702"
NFE_ISS_RATE=""
NFE_AMBIENTE="producao"

# E-mail transacional (Resend). Sem chave fica em mock (só loga).
RESEND_API_KEY=""
EMAIL_FROM="Verus <contato@verusimpermeabilizacoes.com.br>"
EMAIL_REPLY_TO=""

# Arquivos (foto de obra, documentos). "db" guarda no Postgres; "supabase" usa Storage.
STORAGE_PROVIDER="db"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="verus"

# Open-Meteo (previsão do tempo) — gratuito, sem API key. Override apenas para testes.
OPEN_METEO_BASE_URL="https://api.open-meteo.com"

# Acesso por link secreto — deixe VAZIO para desligar o atalho.
# Com um valor (32+ caracteres), abrir /entrar/<valor> entra direto no dashboard.
ACESSO_DIRETO_TOKEN=""

# ── Meta (WhatsApp Cloud API por coexistência + Lead Ads) ──────────────────
# App em developers.facebook.com (pode ser o mesmo app "retric" do mesmo Business).
META_APP_ID=""
META_APP_SECRET=""
# Token de usuário do sistema (Business Settings → System Users). Opcional: sem ele,
# o ERP usa o token trocado no Embedded Signup (salvo em Configuracao).
META_ACCESS_TOKEN=""
# Business ID (portfólio) — lista todas as WABAs em Configurações → WhatsApp
META_BUSINESS_ID=""
# String aleatória usada no handshake do webhook (/api/webhooks/meta)
META_WEBHOOK_VERIFY_TOKEN=""
# Expostos no browser: botão "Conectar número" (Embedded Signup / coexistência)
NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_META_ES_CONFIG_ID=""
# Para usar a Cloud API nos envios automáticos do ERP (link de proposta, gatilho clima):
# WHATSAPP_PROVIDER="meta"

# ── Site público (landing na raiz "/") ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://verus.vercel.app"
# Google tag (Ads "AW-xxxx" ou GA4 "G-xxxx") — opcional
NEXT_PUBLIC_GA_ID=""
# Rótulos de conversão do Google Ads ("AW-xxxx/yyyy") — opcional
NEXT_PUBLIC_GADS_CONV_FORM=""
NEXT_PUBLIC_GADS_CONV_WA=""
# Pixel da Meta — opcional
NEXT_PUBLIC_META_PIXEL_ID=""
